---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Node Not Found | Vinu Varghese">
  <main class="relative min-h-svh flex flex-col items-center justify-center px-6">
    <div class="relative max-w-xl w-full notch border border-graphite/12 dark:border-void/12 bg-graphite/[0.02] dark:bg-void/[0.03]">
      <div class="flex items-center justify-between bg-amber-deep dark:bg-amber-bright px-5 py-2.5">
        <span class="font-mono text-void dark:text-carbon text-xs uppercase tracking-wide">Node error</span>
        <span class="font-mono text-void dark:text-carbon text-xs uppercase tracking-wide">Connection missing</span>
      </div>
      <div class="p-6 md:p-8">
        <p class="font-mono text-xs uppercase tracking-wide text-graphite/55 dark:text-ash mb-4">
          vinu@vinuvarghese.com:~$ trace requested-node
        </p>
        <h1 class="font-display font-extrabold text-8xl md:text-9xl leading-none tracking-tight mb-6">
          404
        </h1>
        <p class="font-sans text-graphite/75 dark:text-ash mb-8">
          No structural connection resolves to this path. The node was never added to the lattice.
        </p>
        <a
          href="/"
          class="notch inline-block bg-amber-deep dark:bg-amber-bright text-void dark:text-carbon font-mono text-sm uppercase tracking-wide px-6 py-3 hover:opacity-90 transition-opacity"
        >
          Return to structure <span aria-hidden="true">+</span>
        </a>
      </div>
    </div>
  </main>
</Layout>
