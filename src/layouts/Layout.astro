---
import '../index.css';
import Footer from '../components/Footer';

const {
  title = 'Vinu Varghese | Technical Architect - Cloud & AI Solutions Expert',
  description = 'Vinu Varghese - Technical Architect with 20+ years of experience in cloud computing (AWS, Azure), artificial intelligence, and full-stack enterprise solutions. Expert in digital transformation, microservices, and scalable system design.',
} = Astro.props;

const siteUrl = 'https://www.vinuvarghese.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const measurementId = 'G-39XTPTVSMS';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Vinu Varghese',
      url: siteUrl,
      image: `${siteUrl}/og-image.png`,
      description,
      jobTitle: 'Technical Architect',
      worksFor: {
        '@type': 'Organization',
        name: 'Xminds Infotech Pvt Ltd',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Kerala',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Thiruvananthapuram',
        addressRegion: 'Kerala',
        addressCountry: 'IN',
      },
      email: 'vinu@vinuvarghese.com',
      sameAs: [
        'https://www.linkedin.com/in/vinuvarghese/',
        'https://github.com/vinu',
        'https://stackoverflow.com/users/674067/jang00',
      ],
      knowsAbout: [
        'Cloud Architecture',
        'AWS',
        'Azure',
        'Artificial Intelligence',
        'Machine Learning',
        'Microservices',
        'Full-Stack Development',
        'DevOps',
        'Enterprise Architecture',
        'Digital Transformation',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Vinu Varghese',
      publisher: { '@id': `${siteUrl}/#person` },
      inLanguage: 'en',
    },
    {
      '@type': 'ProfilePage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: title,
      isPartOf: { '@id': `${siteUrl}/#website` },
      mainEntity: { '@id': `${siteUrl}/#person` },
      inLanguage: 'en',
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function() {
        document.documentElement.classList.add('js');
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (stored !== 'light' && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta name="author" content="Vinu Varghese" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#e6e3df" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0f" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Vinu Varghese" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vinu Varghese - Technical Architect" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
    <script define:vars={{ measurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', measurementId);
    </script>
  </head>
  <body class="bg-concrete text-graphite dark:bg-carbon dark:text-void font-sans antialiased transition-colors duration-300">
    <!--
      THESIS: The portfolio as a tensegrity structure — sections held in
      visible tension, not stacked in a scroll or a broadcast page grid;
      refuses both the flat teletext identity and the generic glass-blob
      SaaS hero.
      OWN-WORLD: Carbon-black/graphite ground, concrete/void-white text,
      one signal-amber accent (split into deep/bright mode-safe variants
      — amber fails contrast on both light AND dark grounds depending on
      direction, so unlike a mid-tone hue there is no single safe bare
      value); condensed industrial grotesk display (set in caps, matching
      the world's signage voice) + engineering-monospace data labels; a
      live-rendered 3D rod-and-cable lattice with joint nodes and a
      contact shadow anchoring the hero, slowly breathing; cut-corner
      tab/button motif with a trailing "+" device on primary actions; a
      dot-plus-rule leader-line annotation used as the system's recurring
      stat/label idiom (REAL data only — years, stack, stats, never
      invented figures) — a 2D annotation motif echoing the structure's
      engineering-callout character, not literal lines routed to 3D
      coordinates. Light mode: daylight-studio register — poured-concrete
      ground, graphite text, same amber accent (deep variant), same
      lattice rendered in dark line-work.
      STORY: A visitor sees the structure holding itself up through
      opposing forces before reading a word, then reads real annotated
      data as they move through each section — balance across many
      domains, no single point of failure, twenty years of systems work
      made physical.
      FIRST VIEWPORT: A dark studio hero: the 3D lattice (rods, tensioned
      cables, joint nodes, ground shadow) rotates slowly beside the name,
      condensed white caps display type, one amber cut-corner primary
      button, leader-line-annotated real stats (years, current role,
      domains) beneath it.
      FORM: Challenger "kinetic-sculpture-automata-tensegrity-breathing-
      column" (challenger-tensegrity), chosen by explicit user pick over
      assigned grounded direction #6 (Atmospheric Signal Field), seed key
      6481619f.
      FINISH: unreviewed and undocumented is unfinished; this build ends
      with the finish review, the verdict, and DESIGN.md
    -->
    <slot />
    <Footer />
  </body>
</html>
